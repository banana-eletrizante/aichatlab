<Window x:Class="AIChatLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Chat Lab"
        Width="1180" Height="720" MinWidth="960" MinHeight="640"
        Background="#06140F" Foreground="#E8FFF5"
        FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0A1F18" BorderBrush="#1C4A36" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16">
          <TextBlock Text="LABORATÓRIO DE IA" FontSize="10" Foreground="#22C55E" FontFamily="Consolas"/>
          <TextBlock Text="AI CHAT LAB" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,12"/>
        </StackPanel>
        <TextBlock x:Name="TokenStatus" DockPanel.Dock="Bottom" Margin="16" FontSize="11" Foreground="#5F8F78" Text="Token Vercel: ausente"/>
        <StackPanel Margin="8">
          <Button Content="01 Experimento" Click="Nav" Tag="1" Margin="0,2" Height="40"/>
          <Button Content="02 Identidade" Click="Nav" Tag="2" Margin="0,2" Height="40"/>
          <Button Content="03 Tema" Click="Nav" Tag="3" Margin="0,2" Height="40"/>
          <Button Content="04 Preview" Click="Nav" Tag="4" Margin="0,2" Height="40"/>
          <Button Content="05 Gerar / Publicar" Click="Nav" Tag="5" Margin="0,2" Height="40"/>
          <Button Content="06 Histórico" Click="Nav" Tag="6" Margin="0,2" Height="40"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24">
      <StackPanel x:Name="Step1">
        <TextBlock Text="Nome" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Height="36" TextChanged="NameChanged"/>
        <TextBlock Text="Slug" Margin="0,12,0,4"/>
        <TextBox x:Name="SlugBox" Height="36" FontFamily="Consolas"/>
        <TextBlock Text="Tagline" Margin="0,12,0,4"/>
        <TextBox x:Name="TaglineBox" Height="36"/>
      </StackPanel>
      <StackPanel x:Name="Step2" Visibility="Collapsed">
        <TextBlock Text="Persona / system prompt"/>
        <TextBlock Text="A persona fica visível no HTML gerado." FontSize="11" Foreground="#86C9A8" Margin="0,0,0,6"/>
        <TextBox x:Name="PersonaBox" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Boas-vindas" Margin="0,12,0,4"/>
        <TextBox x:Name="WelcomeBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
      </StackPanel>
      <StackPanel x:Name="Step3" Visibility="Collapsed">
        <TextBlock Text="Tema padrão: Lab Green (#06140f / #22c55e), o mesmo da landing." TextWrapping="Wrap"/>
      </StackPanel>
      <DockPanel x:Name="Step4" Visibility="Collapsed">
        <Button DockPanel.Dock="Top" Content="Recarregar preview" Click="ReloadPreview" Height="40" Margin="0,0,0,8"/>
        <wv2:WebView2 x:Name="Preview"/>
      </DockPanel>
      <DockPanel x:Name="Step5" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <Button Content="Gerar pasta…" Click="GenerateFolder" Height="40" Margin="0,0,0,8"/>
          <TextBlock Text="Token Vercel" Margin="0,8,0,4"/>
          <PasswordBox x:Name="TokenBox" Height="36"/>
          <Button Content="Salvar token (DPAPI)" Click="SaveToken" Height="40" Margin="0,8,0,8"/>
          <TextBlock Text="Projeto Vercel"/>
          <TextBox x:Name="ProjectBox" Height="36"/>
          <Button Content="Publicar na Vercel" Click="Publish" Height="40" Margin="0,8,0,8"/>
        </StackPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" Background="#04110C" Foreground="#4ADE80" TextWrapping="Wrap"/>
      </DockPanel>
      <ListBox x:Name="Step6" Visibility="Collapsed" Background="#04110C" Foreground="#E8FFF5"/>
    </Grid>
  </Grid>
</Window>
