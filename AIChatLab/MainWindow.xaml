<Window x:Class="AIChatLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Chat Lab v1.1"
        Width="1220" Height="760" MinWidth="980" MinHeight="660"
        Background="#06140F" Foreground="#E8FFF5"
        FontFamily="Segoe UI"
        Icon="Assets/AIChatLab.ico"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="WindowStateChanged"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Ico" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource LabGridBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#071A14" BorderBrush="#1C4A36"
            BorderThickness="0,0,0,1" MouseLeftButtonDown="DragWindow">
      <Grid Margin="12,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="27" Height="27" Margin="0,0,10,0">
            <Ellipse Fill="#14532D" Opacity="0.62"/>
            <Path Data="{StaticResource FlaskGeometry}" Stretch="Uniform" Width="17" Height="17"
                  Stroke="#4ADE80" StrokeThickness="1.8" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Grid>
          <TextBlock Text="AI Chat Lab" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Style="{StaticResource Pill}" Padding="7,2" Margin="10,0,0,0">
            <TextBlock Text="v1.1" Foreground="#86EFAC" FontSize="9" FontWeight="Bold"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowActionBtn}" Click="MinimizeWindow" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource WindowActionBtn}" Click="ToggleMaximize" ToolTip="Maximizar ou restaurar" AutomationProperties.Name="Maximizar ou restaurar janela">
            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource WindowCloseBtn}" Click="CloseWindow" ToolTip="Fechar" AutomationProperties.Name="Fechar janela">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#071A14" BorderBrush="#1C4A36" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,8">
          <Grid Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,12">
            <Ellipse Width="62" Height="62" Fill="#22C55E" Opacity="0.10"/>
            <Ellipse Width="50" Height="50" Fill="#14532D" Opacity="0.42"/>
            <Path Data="{StaticResource FlaskGeometry}" Stretch="Uniform"
                  Width="38" Height="38" Stroke="#4ADE80" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Border Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1"
                    CornerRadius="4" Padding="5,1" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,2">
              <TextBlock Text="AI" Foreground="#86EFAC" FontSize="8" FontWeight="Bold"/>
            </Border>
          </Grid>
          <TextBlock Text="LABORATÓRIO DE IA" FontSize="10" FontWeight="Bold" Foreground="#22C55E"/>
          <TextBlock Text="AI CHAT LAB" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
          <TextBlock Text="Configure e publique seu chat." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
          <TextBlock Text="Idioma do app" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
          <ComboBox x:Name="LangBox" SelectedIndex="0" Height="34" AutomationProperties.Name="Idioma do app">
            <ComboBoxItem Content="Português" Tag="pt"/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Español" Tag="es"/>
          </ComboBox>
          <TextBlock x:Name="TokenStatus" Margin="0,12,0,0" FontSize="11" Foreground="#6B8F7A" Text="Token Vercel: ausente"/>
        </StackPanel>

        <StackPanel Margin="12,8">
          <Button x:Name="Nav1" Style="{StaticResource NavBtnActive}" Click="Nav" Tag="1" AutomationProperties.Name="Passo 01, Experimento">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/><TextBlock Text="01  Experimento"/>
            </StackPanel>
          </Button>
          <Button x:Name="Nav2" Style="{StaticResource NavBtn}" Click="Nav" Tag="2" AutomationProperties.Name="Passo 02, Identidade">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE9F5;"/><TextBlock Text="02  Identidade"/>
            </StackPanel>
          </Button>
          <Button x:Name="Nav3" Style="{StaticResource NavBtn}" Click="Nav" Tag="3" AutomationProperties.Name="Passo 03, Tema">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE790;"/><TextBlock Text="03  Tema"/>
            </StackPanel>
          </Button>
          <Button x:Name="Nav4" Style="{StaticResource NavBtn}" Click="Nav" Tag="4" AutomationProperties.Name="Passo 04, Preview">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE7F4;"/><TextBlock Text="04  Preview"/>
            </StackPanel>
          </Button>
          <Button x:Name="Nav5" Style="{StaticResource NavBtn}" Click="Nav" Tag="5" AutomationProperties.Name="Passo 05, Gerar e publicar">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE896;"/><TextBlock Text="05  Gerar / Publicar"/>
            </StackPanel>
          </Button>
          <Button x:Name="Nav6" Style="{StaticResource NavBtn}" Click="Nav" Tag="6" AutomationProperties.Name="Passo 06, Histórico">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE81C;"/><TextBlock Text="06  Histórico"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="28,20,28,0">
        <DockPanel>
          <TextBlock x:Name="StepKicker" DockPanel.Dock="Top" Text="PASSO 01" FontSize="11" FontWeight="Bold" Foreground="#22C55E" Margin="0,0,0,4"/>
          <TextBlock x:Name="StepTitle" Text="Defina o experimento" FontSize="26" FontWeight="Bold"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,16,28,24">
        <Grid>
          <StackPanel x:Name="Step1">
            <TextBlock Text="Defina o nome e o endereço do site. Cada visitante informa a própria chave OpenRouter." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
            <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Height="42" TextChanged="NameChanged" AutomationProperties.Name="Nome do experimento"/>
            <TextBlock x:Name="NameError" Style="{StaticResource ErrorText}" Text="Nome deve ter 2–48 caracteres."/>
            <TextBlock Text="Slug" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <TextBox x:Name="SlugBox" Height="42" FontFamily="Consolas" TextChanged="SlugChanged" AutomationProperties.Name="Slug do site"/>
            <TextBlock x:Name="SlugError" Style="{StaticResource ErrorText}" Text="Slug: 3–48 caracteres, a-z, 0-9 e hífen."/>
            <TextBlock Text="Tagline" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <TextBox x:Name="TaglineBox" Height="42" AutomationProperties.Name="Tagline"/>
            <TextBlock Text="Frase curta abaixo do título no site gerado." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="Step2" Visibility="Collapsed">
            <TextBlock Text="Persona / system prompt" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="A persona fica visível no HTML gerado — trate-a como pública." Style="{StaticResource Hint}"/>
            <TextBox x:Name="PersonaBox" Height="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="PersonaChanged" AutomationProperties.Name="Persona ou system prompt"/>
            <Grid>
              <TextBlock x:Name="PersonaError" Style="{StaticResource ErrorText}" Text="Persona deve ter pelo menos 20 caracteres."/>
              <TextBlock x:Name="PersonaCount" Text="0 caracteres" FontFamily="Consolas" FontSize="11"
                         Foreground="#6B8F7A" HorizontalAlignment="Right" Margin="0,7,0,0"/>
            </Grid>
            <TextBlock Text="Boas-vindas" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <TextBox x:Name="WelcomeBox" Height="96" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Mensagem de boas-vindas"/>
            <TextBlock Text="Primeira mensagem do assistente no chat." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="Step3" Visibility="Collapsed">
            <TextBlock Text="O site gerado usa a paleta Lab Green. Você pode mostrar ou ocultar o grid e a assinatura." Style="{StaticResource Hint}"/>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,16" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="18" BorderBrush="#1C4A36" BorderThickness="0,0,0,1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="66"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" HorizontalAlignment="Left">
                      <Ellipse Fill="#14532D" Opacity="0.55"/>
                      <Path Data="{StaticResource FlaskGeometry}" Stretch="Uniform" Width="31" Height="31"
                            Stroke="#4ADE80" StrokeThickness="1.8" StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="LAB GREEN" Style="{StaticResource Eyebrow}"/>
                      <TextBlock Text="Paleta do site gerado" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/>
                      <TextBlock Text="Fundo escuro, texto claro e destaque verde." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,7,0"/>
                        <TextBlock Text="ATIVO" Foreground="#86EFAC" FontSize="10" FontWeight="Bold"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Border Height="34" CornerRadius="9" Background="#06140F" BorderBrush="#22C55E" BorderThickness="1" Margin="0,0,8,6"/>
                    <TextBlock Text="FUNDO" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="#06140F" FontFamily="Consolas" Foreground="#86EFAC" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <Border Height="34" CornerRadius="9" Background="#0A1F18" BorderBrush="#1C4A36" BorderThickness="1" Margin="0,0,8,6"/>
                    <TextBlock Text="SUPERFÍCIE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="#0A1F18" FontFamily="Consolas" Foreground="#86EFAC" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Border Height="34" CornerRadius="9" Background="#22C55E" Margin="0,0,8,6"/>
                    <TextBlock Text="DESTAQUE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="#22C55E" FontFamily="Consolas" Foreground="#86EFAC" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                    <Border Height="34" CornerRadius="9" Background="#4ADE80" Margin="0,0,0,6"/>
                    <TextBlock Text="SOFT" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="#4ADE80" FontFamily="Consolas" Foreground="#86EFAC" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Grid do laboratório" FontWeight="SemiBold"/>
                    <TextBlock Text="Mantém a textura sutil da landing." Style="{StaticResource Hint}" Margin="0,4,12,0"/>
                  </StackPanel>
                  <CheckBox Grid.Column="1" x:Name="GridCheck" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Mostrar grid do laboratório"/>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Assinatura no rodapé" FontWeight="SemiBold"/>
                    <TextBlock Text="Mostra que o site foi feito no Lab." Style="{StaticResource Hint}" Margin="0,4,12,0"/>
                  </StackPanel>
                  <CheckBox Grid.Column="1" x:Name="BrandCheck" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Mostrar assinatura no rodapé"/>
                </Grid>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                  <TextBlock Text="Modelo padrão" FontWeight="SemiBold"/>
                  <TextBlock Text="É a primeira opção do visitante; ele ainda poderá trocar no chat." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="ModelBox" Height="42" SelectedIndex="0" AutomationProperties.Name="Modelo padrão">
                  <ComboBoxItem Content="openai/gpt-4o-mini"/>
                  <ComboBoxItem Content="openai/gpt-4o"/>
                  <ComboBoxItem Content="anthropic/claude-3.5-sonnet"/>
                  <ComboBoxItem Content="google/gemini-2.0-flash-001"/>
                  <ComboBoxItem Content="meta-llama/llama-3.3-70b-instruct"/>
                  <ComboBoxItem Content="deepseek/deepseek-chat"/>
                  <ComboBoxItem Content="mistralai/mistral-nemo"/>
                </ComboBox>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel x:Name="Step4" Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="Seu chat, antes de publicar" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="O modo preview usa respostas de demonstração e nunca pede chave OpenRouter." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Click="ReloadPreview" Padding="15,0" AutomationProperties.Name="Atualizar preview">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Ico}" Text="&#xE72C;"/>
                  <TextBlock Text="Atualizar preview"/>
                </StackPanel>
              </Button>
            </Grid>

            <TextBlock x:Name="PreviewError" Style="{StaticResource ErrorText}" Margin="0,0,0,10"/>
            <Border Height="440" CornerRadius="18" BorderBrush="#1C4A36" BorderThickness="1"
                    ClipToBounds="True" Background="#04110C">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#0A1F18" BorderBrush="#1C4A36" BorderThickness="0,0,0,1" Padding="14,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{StaticResource Ico}" Foreground="#86EFAC" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#04110C" CornerRadius="9" Margin="18,8" Padding="12,0">
                      <TextBlock Text="preview.local/ai-chat" Foreground="#6B8F7A" FontFamily="Consolas"
                                 FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="PreviewStatusDot" Width="7" Height="7" Fill="#6B8F7A" Margin="0,0,7,0"/>
                      <TextBlock x:Name="PreviewStatus" Text="Aguardando" Foreground="#86EFAC" FontSize="11"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid Grid.Row="1">
                  <wv2:WebView2 x:Name="Preview" NavigationCompleted="PreviewNavigationCompleted"/>
                  <Border x:Name="PreviewOverlay" Background="#04110C" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Grid Width="74" Height="74" HorizontalAlignment="Center">
                        <Ellipse Fill="#14532D" Opacity="0.48"/>
                        <Path Data="{StaticResource FlaskGeometry}" Stretch="Uniform" Width="42" Height="42"
                              Stroke="#4ADE80" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      </Grid>
                      <TextBlock x:Name="PreviewOverlayTitle" Text="Preencha os passos 01 e 02" FontWeight="SemiBold" FontSize="14"
                                 HorizontalAlignment="Center" Margin="0,14,0,0"/>
                      <TextBlock x:Name="PreviewOverlayBody" Text="O preview será liberado quando os dados obrigatórios estiverem completos."
                                 Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </StackPanel>

          <DockPanel x:Name="Step5" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Gera a pasta do site ou publica direto na Vercel. Nenhuma chave OpenRouter entra no pacote." Style="{StaticResource Hint}"/>
              <Button Style="{StaticResource PrimaryBtn}" Click="GenerateFolder" Margin="0,4,0,16" AutomationProperties.Name="Gerar arquivos do site">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Ico}"/>
                  <TextBlock Text="Gerar arquivos do site"/>
                </StackPanel>
              </Button>
              <TextBlock Text="Token Vercel" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="TokenBox" Height="42" AutomationProperties.Name="Token Vercel"/>
              <TextBlock Text="Fica só neste PC (DPAPI). Não vai para o histórico nem para o site gerado." Style="{StaticResource Hint}" Margin="0,6,0,8"/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostBtn}" Click="SaveToken" AutomationProperties.Name="Salvar token neste PC">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource Ico}"/>
                    <TextBlock Text="Salvar neste PC"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Click="ForgetToken" AutomationProperties.Name="Esquecer token">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Ico}"/>
                    <TextBlock Text="Esquecer token"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="Nome do projeto Vercel" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ProjectBox" Height="42" AutomationProperties.Name="Nome do projeto Vercel"/>
              <Button Style="{StaticResource PrimaryBtn}" Click="Publish" Margin="0,14,0,12" AutomationProperties.Name="Publicar na Vercel">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74C;" Style="{StaticResource Ico}"/>
                  <TextBlock Text="Publicar na Vercel"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="PublishError" Style="{StaticResource ErrorText}" Margin="0,0,0,8"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
              <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                       Background="Transparent" Foreground="#4ADE80" BorderThickness="0"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       AcceptsReturn="True" Text="> pronto&#x0a;"/>
            </Border>
          </DockPanel>

          <DockPanel x:Name="Step6Host" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="Experimentos gerados neste PC." Style="{StaticResource Hint}"/>
            <ListBox x:Name="Step6" Background="Transparent" BorderThickness="0" Foreground="#E8FFF5" FontSize="13" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#F206140F" BorderBrush="#1C4A36" BorderThickness="0,1,0,0"
              Padding="28,14,28,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ProgressText" Text="01 / 06" FontFamily="Consolas" FontSize="11"
                       Foreground="#86EFAC" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ItemsControl x:Name="ProgressDots">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BackButton" Style="{StaticResource QuietBtn}" Click="PreviousStep" Margin="0,0,10,0" AutomationProperties.Name="Voltar ao passo anterior">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Ico}"/>
                <TextBlock Text="Voltar"/>
              </StackPanel>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource PrimaryBtn}" Click="NextStep" MinWidth="132" AutomationProperties.Name="Continuar para o próximo passo">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Continuar" Margin="0,0,10,0"/>
                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
